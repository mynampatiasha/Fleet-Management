{
  "rules": {
    // ============================================
    // ROSTER REQUESTS (Main issue causing permission denied)
    // ============================================
    "roster_requests": {
      ".read": "auth != null && auth.token.email == 'admin@abrafleet.com'",
      ".write": "auth != null"
    },
    
    // ============================================
    // SOS EVENTS COLLECTION
    // ============================================
    "sos_events": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": "customerId"
    },
    
    // ============================================
    // NOTIFICATIONS COLLECTION
    // ============================================
    "notifications": {
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null",
        ".indexOn": ["isRead", "createdAt", "type"]
      }
    },
    
    // ============================================
    // DRIVER LOCATIONS (Real-time tracking)
    // ============================================
    "driver_locations": {
      ".read": "auth != null",
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.uid == $driverId || auth.token.email == 'admin@abrafleet.com')"
      }
    },
    
    // ============================================
    // TRIPS COLLECTION
    // ============================================
    "trips": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".indexOn": ["customerId", "driverId", "status", "tripDate"]
    },
    
    // ============================================
    // VEHICLES COLLECTION
    // ============================================
    "vehicles": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == 'admin@abrafleet.com'",
      ".indexOn": ["status", "vehicleType"]
    },
    
    // ============================================
    // DRIVERS COLLECTION
    // ============================================
    "drivers": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.email == 'admin@abrafleet.com'",
      "$driverId": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.email == 'admin@abrafleet.com'"
      },
      ".indexOn": ["status", "availabilityStatus"]
    },
    
    // ============================================
    // CUSTOMERS COLLECTION
    // ============================================
    "customers": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    
    // ============================================
    // USERS METADATA
    // ============================================
    "users": {
      ".read": "auth != null",
      "$userId": {
        ".read": "auth != null && auth.uid == $userId",
        ".write": "auth != null && auth.uid == $userId"
      }
    },
    
    // ============================================
    // APP CONFIGURATION (Public read, admin write)
    // ============================================
    "config": {
      ".read": true,
      ".write": "auth != null && auth.token.email == 'admin@abrafleet.com'"
    },
    
    // ============================================
    // DEFAULT FALLBACK - Admin has full access
    // ============================================
    ".read": "auth != null && auth.token.email == 'admin@abrafleet.com'",
    ".write": "auth != null && auth.token.email == 'admin@abrafleet.com'"
  }
}