  // ✅ CREATE CLIENT (Keep existing method)
  Future<void> _createClient({
    required String name,
    required String email,
    required String password,
    required String phone,
    required String address,
    required String contactPerson,
    String? branch, // Add branch parameter
    String? gstNumber,
    String? panNumber,
  }) async {
    final currentAdmin = FirebaseAuth.instance.currentUser;
    
    if (currentAdmin == null) {
      throw Exception('Admin must be logged in');
    }

    final adminUid = currentAdmin.uid;
    final adminEmail = currentAdmin.email;
    
    debugPrint('👤 Admin UID: $adminUid');
    debugPrint('📧 Admin Email: $adminEmail');

    try {
      // Verify admin role
      final adminDoc = await FirebaseFirestore.instance
          .collection('users')
          .doc(adminUid)
          .get();
      
      debugPrint('📄 Admin Doc exists: ${adminDoc.exists}');
      
      if (!adminDoc.exists) {
        throw Exception('Admin user document not found in Firestore');
      }
      
      final adminRole = adminDoc.data()?['role'];
      debugPrint('👔 Admin Role: $adminRole');
      
      if (adminRole != 'admin') {
        throw Exception('Only admins can create client accounts. Your role: $adminRole');
      }

      debugPrint('🔐 Creating client Firebase Auth account using secondary app...');
      
      // Create or get secondary Firebase app instance
      FirebaseApp tempApp;
      try {
        tempApp = Firebase.app('temporaryClientCreation');
      } catch (e) {
        tempApp = await Firebase.initializeApp(
          name: 'temporaryClientCreation',
          options: Firebase.app().options,
        );
      }
      
      // Use secondary auth instance
      final tempAuth = FirebaseAuth.instanceFor(app: tempApp);
      
      // Create client user with secondary auth
      final userCredential = await tempAuth.createUserWithEmailAndPassword(
        email: email,
        password: password,
      );

      final clientUserId = userCredential.user!.uid;
      debugPrint('✅ Client Auth account created: $clientUserId');

      // Sign out from temporary auth immediately
      await tempAuth.signOut();
      debugPrint('✅ Signed out from temporary auth instance');

      // Create Firestore user document with "client" role
      debugPrint('📝 Creating Firestore user document with CLIENT role...');
      await FirebaseFirestore.instance.collection('users').doc(clientUserId).set({
        'email': email,
        'name': contactPerson,
        'role': 'client',
        'companyName': name,
        'phoneNumber': phone,
        'address': address,
        'branch': branch, // Add branch field
        'gstNumber': gstNumber,
        'panNumber': panNumber,
        'authProvider': 'email',
        'createdAt': FieldValue.serverTimestamp(),
        'updatedAt': FieldValue.serverTimestamp(),
        'createdBy': adminUid,
        'status': 'active',
      });
      
      debugPrint('✅ Firestore user document created with role: client');

      // Create Realtime Database entry
      debugPrint('💾 Creating Realtime Database entry...');
      final clientRef = FirebaseDatabase.instance.ref('clients').push();
      await clientRef.set({
        'userId': clientUserId,
        'name': name,
        'email': email,
        'phone': phone,
        'address': address,
        'contactPerson': contactPerson,
        'branch': branch, // Add branch field
        'gstNumber': gstNumber,
        'panNumber': panNumber,
        'createdAt': DateTime.now().toIso8601String(),
        'createdBy': adminUid,
        'status': 'active',
        'totalCustomers': 0,
        'activeVehicles': 0,
      });
      
      debugPrint('✅ Client created in RTDB: ${clientRef.key}');
      
      // Verify admin is still logged in
      final stillLoggedIn = FirebaseAuth.instance.currentUser;
      debugPrint('✅ Admin still logged in: ${stillLoggedIn?.email}');
      debugPrint('✅ Admin UID still: ${stillLoggedIn?.uid}');
      
      debugPrint('🎉 Client creation completed! Admin session preserved.');
      
    } catch (e) {
      debugPrint('❌ Error creating client: $e');
      rethrow;
    }
  }

