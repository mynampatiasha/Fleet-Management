  Future<void> _syncCustomerCounts() async {
    try {
      debugPrint('🔄 Syncing customer counts with improved logic...');
      
      final apiService = BackendConnectionManager().apiService;
      final response = await apiService.post('/clients/sync-customer-counts', body: {
        'forceRefresh': true, // Force a complete refresh
      });
      
      if (response['success'] == true) {
        debugPrint('✅ Customer counts synced successfully: ${response['message']}');
        debugPrint('📊 Total customers processed: ${response['totalCustomers']}');
        debugPrint('🏢 Clients updated: ${response['updated']}');
        
        // Show success message to user
        if (mounted) {
          ScaffoldMessenger.of(context).showSnackBar(
            SnackBar(
              content: Text('✅ Customer counts updated: ${response['updated']} clients'),
              backgroundColor: Colors.green,
              duration: const Duration(seconds: 2),
            ),
          );
        }
      } else {
        debugPrint('⚠️ Sync response not successful: ${response}');
      }
    } catch (e) {
      debugPrint('⚠️ Failed to sync customer counts: $e');
      // Show error to user if sync fails
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          const SnackBar(
            content: Text('⚠️ Failed to update customer counts. Please try refreshing.'),
            backgroundColor: Colors.orange,
            duration: Duration(seconds: 3),
          ),
        );
      }
    }
  }

  Future<void> _loadClients() async {
    setState(() => _isLoading = true);
    
    // Sync customer counts before loading
    await _syncCustomerCounts();
    
    try {
      final ref = FirebaseDatabase.instance.ref('clients');
      final snapshot = await ref.get();

      if (snapshot.exists) {
        final List<ClientEntity> loadedClients = [];
        final data = snapshot.value as Map<dynamic, dynamic>;
        
        data.forEach((key, value) {
          if (value is Map) {
            loadedClients.add(ClientEntity.fromJson(value, key));
          }
        });

        loadedClients.sort((a, b) => b.createdAt.compareTo(a.createdAt));

        if (mounted) {
          setState(() {
            _clients = loadedClients;
            _isLoading = false;
          });
        }
      } else {
        if (mounted) {
          setState(() {
            _clients = [];
            _isLoading = false;
          });
        }
      }
    } catch (e) {
      debugPrint('Error loading clients: $e');
      if (mounted) {
        setState(() => _isLoading = false);
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Error loading clients: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  }

  List<ClientEntity> get _filteredClients {
    if (_searchQuery.isEmpty) return _clients;
    return _clients.where((client) {
      return client.name.toLowerCase().contains(_searchQuery.toLowerCase()) ||
             client.email.toLowerCase().contains(_searchQuery.toLowerCase()) ||
             client.phone.contains(_searchQuery);
    }).toList();
  }

  // ✅ UPDATE CLIENT STATUS (Realtime Database + Firestore)
  Future<void> _updateClientStatus(ClientEntity client, String newStatus) async {
    try {
      debugPrint('🔄 Updating client status: ${client.id} to $newStatus');
      
      // Update in Realtime Database
      await FirebaseDatabase.instance
          .ref('clients/${client.id}')
          .update({'status': newStatus});
      
      // Update in Firestore (if userId exists)
      if (client.userId != null && client.userId!.isNotEmpty) {
        await FirebaseFirestore.instance
            .collection('users')
            .doc(client.userId)
            .update({
          'status': newStatus,
          'updatedAt': FieldValue.serverTimestamp(),
        });
      }
      
      debugPrint('✅ Client status updated successfully');
      
      // Reload clients
      await _loadClients();
      
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Client status updated to ${newStatus.toUpperCase()}'),
            backgroundColor: Colors.green,
          ),
        );
      }
    } catch (e) {
      debugPrint('❌ Error updating client status: $e');
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Error updating status: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  }

  // ✅ DELETE CLIENT (Realtime Database + Firestore + Firebase Auth)
  Future<void> _deleteClient(ClientEntity client) async {
    // Show confirmation dialog
    final confirmed = await showDialog<bool>(
      context: context,
      builder: (context) => AlertDialog(
        title: const Row(
          children: [
            Icon(Icons.warning, color: Colors.orange),
            SizedBox(width: 12),
            Text('Delete Client'),
          ],
        ),
        content: Text(
          'Are you sure you want to delete "${client.name}"?\n\n'
          'This will:\n'
          '• Remove client from database\n'
          '• Delete user account\n'
          '• This action cannot be undone!',
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context, false),
            child: const Text('Cancel'),
          ),
          ElevatedButton(
            onPressed: () => Navigator.pop(context, true),
            style: ElevatedButton.styleFrom(
              backgroundColor: Colors.red,
              foregroundColor: Colors.white,
            ),
            child: const Text('Delete'),
          ),
        ],
      ),
    );

    if (confirmed != true) return;

    try {
      debugPrint('🗑️ Deleting client: ${client.id}');
      
      // 1. Delete from Realtime Database
      await FirebaseDatabase.instance
          .ref('clients/${client.id}')
          .remove();
      debugPrint('✅ Deleted from Realtime Database');
      
      // 2. Delete from Firestore (if userId exists)
      if (client.userId != null && client.userId!.isNotEmpty) {
        await FirebaseFirestore.instance
            .collection('users')
            .doc(client.userId)
            .delete();
        debugPrint('✅ Deleted from Firestore');
      }
      
      // Note: Firebase Auth user deletion requires admin SDK or the user to be signed in
      // For security, we keep the auth account but mark as deleted in Firestore
      
      debugPrint('✅ Client deleted successfully');
      
      // Reload clients
      await _loadClients();
      
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Client "${client.name}" deleted successfully'),
            backgroundColor: Colors.green,
          ),
        );
      }
    } catch (e) {
      debugPrint('❌ Error deleting client: $e');
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Error deleting client: $e'),
            backgroundColor: Colors.red,
          ),
        );
      }
    }
  }

