                      hintText: 'e.g., Bangalore, Chennai, Mumbai',
                    ),
                  ),
                  const SizedBox(height: 16),
                  TextFormField(
                    controller: panController,
                    decoration: const InputDecoration(
                      labelText: 'PAN Number (Optional)',
                      border: OutlineInputBorder(),
